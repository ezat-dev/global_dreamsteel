@echo off
REM Copy this file to run-backend.bat and set JAVA_HOME to this PC's JDK 17.
REM DB host / user / password are NOT here any more - put them in local.yml at the repo root
REM (copy local.yml.example). The backend reads that one file whether started here or as a service.
title SCADA Backend (8081)
set "JAVA_HOME=C:\Program Files\Eclipse Adoptium\jdk-17.0.20.101-hotspot"
set "PATH=%JAVA_HOME%\bin;%PATH%"
cd /d "%~dp0backend"
REM --console=plain: turn off Gradle's progress bar. The bar redraws every second
REM ("<====----> 75% EXECUTING [3m 12s]"), which yanks the console back to the
REM bottom and makes it impossible to scroll up and read the log.
call "%cd%\gradlew.bat" bootRun --console=plain

echo.
echo [backend process exited - see log above. Press any key to close this window]
pause >nul
