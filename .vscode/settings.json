{
    // build.gradle이 바뀌면 물어보지 않고 바로 클래스패스를 다시 읽는다.
    // "interactive"로 두면 확인 팝업을 놓쳤을 때 클래스패스가 옛날 상태로 남아
    // import가 안 잡히거나 빨간 줄이 안 뜨는 일이 생긴다.
    "java.configuration.updateBuildConfiguration": "automatic",
    "java.compile.nullAnalysis.mode": "automatic",
    // 워크스페이스 루트가 global_dreamsteel이고 Gradle 프로젝트는 backend/ 한 단계 아래라
    // 위치를 명시해준다.
    "java.import.gradle.enabled": true,
    /* Gradle 동기화에 쓸 JDK. 시스템 JAVA_HOME이 1.8을 가리키고 있는데 Gradle은
       JVM 17 미만이면 실행 자체를 거부한다 — 동기화가 조용히 실패하면서 클래스패스가
       옛날 상태로 남고, 새로 추가한 의존성(예: poi-ooxml)이 계속 '해결할 수 없음'으로
       빨간 줄이 뜬다. 코드는 멀쩡한데 IDE만 모르는 상태가 된다.
       run-backend.bat도 같은 이유로 자기 안에서 JAVA_HOME을 17로 바꿔 쓴다.
       (PC마다 경로가 다르면 이 두 줄만 고치면 된다) */
    "java.import.gradle.java.home": "C:\\Program Files\\Java\\jdk-17",
    "java.jdt.ls.java.home": "C:\\Program Files\\Java\\jdk-17",
    "java.project.sourcePaths": [
        "backend/src/main/java"
    ]
}
