<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ScadaAlarmMapper">

    <select id="getAlarmList" parameterType="com.mes.domain.scada.ScadaAlarm"
            resultType="com.mes.domain.scada.ScadaAlarm">
        SELECT * FROM ez_scada.vw_alarm_history
        <!-- 발생시각 범위. 한쪽만 채워 보내면 그쪽 경계만 걸리고, 둘 다 비면 전체를 조회한다. -->
        <where>
            <if test="startTime != null and startTime != ''">
                AND occure_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND occure_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY occur_time_str DESC
    </select>

        <select id="getTrendList" parameterType="com.mes.domain.scada.ScadaAlarm"
            resultType="com.mes.domain.scada.ScadaAlarm">
        SELECT * FROM ez_scada.tb_temp_snapshot
        <!-- 발생시각 범위. 한쪽만 채워 보내면 그쪽 경계만 걸리고, 둘 다 비면 전체를 조회한다. -->
        <where>
            <if test="startTime != null and startTime != ''">
                AND record_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND record_time &lt;= #{endTime}
            </if>
        </where>
    </select>

</mapper>
