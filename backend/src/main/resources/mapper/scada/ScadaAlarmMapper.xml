<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="ScadaAlarmMapper">

    <select id="getAlarmList" parameterType="com.mes.domain.scada.ScadaAlarm"
            resultType="com.mes.domain.scada.ScadaAlarm">
        SELECT * FROM ez_scada.vw_alarm_history
        <!-- 발생시각 범위. 한쪽만 채워 보내면 그쪽 경계만 걸리고, 둘 다 비면 전체를 조회한다. -->
        <where>
            <if test="startTime != null and startTime != ''">
                AND occur_time &gt;= #{startTime}
            </if>
            <if test="endTime != null and endTime != ''">
                AND occur_time &lt;= #{endTime}
            </if>
        </where>
        ORDER BY occur_time_str DESC
        <!-- 건수 상한. 안 주면 전부 내린다(경보이력 화면). 구동·연소화면은 하단 목록을
             5초마다 다시 받으므로 최근 100건만 달라고 한다 — 안 걸면 행이 쌓인 뒤에
             5초마다 이력 전체가 오간다. -->
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <select id="getAlarmTagList" parameterType="com.mes.domain.scada.ScadaAlarm"
            resultType="com.mes.domain.scada.ScadaAlarm">
            SELECT a.tag_name, a.address, a.alarm_msg, a.level,
                l.id AS lamp_id                     
            FROM ez_scada.tb_alarm_tag a                 
            LEFT JOIN ez_scada.folders_tags l
                    ON l.folder_id = 6
                    AND l.name = CONCAT(a.tag_name, '_lamp')
            WHERE a.folder_id = 54                           
            AND a.enabled = 1
            ORDER BY a.tag_id
    </select>

</mapper>
